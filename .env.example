# Local development configuration. Copy this file before running on your host:
#
#   cp .env.example .env
#
# Docker Compose injects its own values (see docker-compose.yaml), so .env is
# only needed for `make migrate`, `make seed`, `make test` and direct `uv` runs.

# --- Required: the gateway refuses to start if any of these are missing. ---
DATABASE_URL=postgresql+asyncpg://sms:sms@localhost:5432/sms
REDIS_URL=redis://localhost:6379/0
DLR_SECRET=change-me
ADMIN_API_KEY=change-me

# --- Optional: sensible local defaults. ---
CARRIER_URL=http://localhost:8001
CARRIER_SUBMIT_RATE=20
