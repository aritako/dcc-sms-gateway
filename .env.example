# Local development configuration. Copy this file before running on your host:
#
#   cp .env.example .env
#
# Docker Compose injects its own values (see docker-compose.yaml), so .env is
# only needed for `make migrate`, `make seed`, `make test`, `make smoke` and
# direct `uv` runs. Compose also reads .env for the host ports below.

# --- Required: the gateway refuses to start if any of these are missing. ---
DATABASE_URL=postgresql+asyncpg://sms:sms@localhost:5432/sms
REDIS_URL=redis://localhost:6379/0
DLR_SECRET=change-me
ADMIN_API_KEY=change-me

# --- Optional: sensible local defaults. ---
CARRIER_URL=http://localhost:8001
CARRIER_SUBMIT_RATE=20

# --- Compose host ports. Change these when the defaults are taken; internal
# service URLs (postgres:5432, redis:6379, api:8000, carrier:8001) do not
# change. When overriding POSTGRES_PORT, update DATABASE_URL above to match. ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
CARRIER_PORT=8001
PGADMIN_PORT=5050
